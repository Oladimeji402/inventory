# Leave blank to run fully offline-first (data lives in the browser's localStorage,
# seeded from src/data/seed.json). Sales always write locally first so a network
# drop cannot interrupt checkout.
#
# Once your backend is ready, set this to its base URL. The app still saves on
# the till first, then syncs to the API when online. Failed/offline writes are
# queued and flushed automatically when the connection returns.
# See src/services/store.js for the request shape
# (/products, /employees, /sales, /audit-log).
VITE_API_BASE_URL=

# ── Brand identity ────────────────────────────────────────────────────────────
# Uncomment and set any of these to override the defaults in src/config/brand.js
# VITE_BRAND_NAME=Subtech
# VITE_BRAND_TAGLINE=Retail OS
# VITE_BRAND_DOMAIN=stv.com
# VITE_BRAND_COLOR=#2B7CFF
# VITE_BRAND_COLOR_DARK=#1a6ae8

# ── Supabase (merchant auth) ──────────────────────────────────────────────────
# Project: Stv  
# Copy the anon public key from Dashboard → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Surfaces (one codebase, four Vercel projects later) ──────────────────────
# auto = detect from hostname locally (merchant.localhost) and from path on Vercel
# VITE_APP_SURFACE=auto
# Override a dedicated deploy later: VITE_APP_SURFACE=merchant
#
# Confirm-email / password-reset always return to the origin you signed up from:
#   local  → http://merchant.localhost:5173/login
#   live   → https://inventory-grab.vercel.app/login
# Add both to Supabase → Authentication → URL Configuration (Site URL + Redirect URLs).

# Leave blank to run fully offline-first (data lives in the browser's localStorage,
# seeded from src/data/seed.json). Sales always write locally first so a network
# drop cannot interrupt checkout.
#
# Once your backend is ready, set this to its base URL. The app still saves on
# the till first, then syncs to the API when online. Failed/offline writes are
# queued and flushed automatically when the connection returns.
# See src/services/store.js for the request shape
# (/products, /employees, /sales, /audit-log).
VITE_API_BASE_URL=
